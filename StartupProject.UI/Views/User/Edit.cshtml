@using StartupProject.AdminUI.Models
@model UserViewModel

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="page-header d-print-none mb-4 mt-2">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Kullanıcı Düzenle</h2>
        </div>
    </div>
</div>

<div class="row row-cards">
    <div class="col-12">
        <div class="card shadow-sm">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Ad</label>
                            <input asp-for="Name" class="form-control" required>
                        </div>
                        <div class="col-md-6 mt-3 mt-md-0">
                            <label class="form-label required">Soyad</label>
                            <input asp-for="Surname" class="form-control" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Email Adresi</label>
                            <input asp-for="Email" type="email" class="form-control" required>
                        </div>
                        <div class="col-md-6 mt-3 mt-md-0">
                            <label class="form-label required">Yetki Rolü</label>
                            <select asp-for="Role" class="form-select">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                                <option value="SuperAdmin">SuperAdmin</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <a href="javascript:history.back()" class="btn btn-link">İptal</a>
                    <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>