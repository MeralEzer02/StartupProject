@using StartupProject.AdminUI.Models
@model List<UserViewModel>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mt-5">
    <h2>Sisteme Kayıtlı Kullanıcılar</h2>
    <hr />

    <ul class="list-group mt-3">
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @user.Name @user.Surname
                    <span class="badge bg-primary rounded-pill">@user.Role</span>
                </li>
            }
        }
        else
        {
            <div class="alert alert-warning">Sistemde henüz kullanıcı bulunmuyor veya API bağlantısı kurulamadı.</div>
        }
    </ul>
</div>