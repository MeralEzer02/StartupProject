<aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <h1 class="navbar-brand navbar-brand-autodark mt-lg-3">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                <span class="fs-2 fw-bold text-white">StartupProject</span><br />
                <span class="text-muted fs-5 d-none d-lg-block">Admin Panel</span>
            </a>
        </h1>

        <div class="navbar-nav flex-row d-lg-none">
            <div class="d-flex me-3">
                <a href="#" onclick="changeTheme('dark'); return false;" class="nav-link px-0 hide-theme-dark" title="Karanlık Mod">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" /></svg>
                </a>
                <a href="#" onclick="changeTheme('light'); return false;" class="nav-link px-0 hide-theme-light" title="Aydınlık Mod">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" /><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" /></svg>
                </a>
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                        <span class="avatar avatar-sm" style="background-image: url(https://ui-avatars.com/api/?name=@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value)"></span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                        <a asp-controller="Profile" asp-action="Index" class="dropdown-item">Profil</a>
                        <a asp-controller="Settings" asp-action="Index" class="dropdown-item">Ayarlar</a>
                        <div class="dropdown-divider"></div>
                        <a asp-controller="Auth" asp-action="Logout" class="dropdown-item text-danger fw-bold">Çıkış Yap</a>
                    </div>
                </div>
            }
        </div>
        <div class="collapse navbar-collapse" id="sidebar-menu">
            <ul class="navbar-nav pt-lg-3">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <span class="nav-link-title">Ana Sayfa</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="User" asp-action="Index">
                        <span class="nav-link-title">Kullanıcılar</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Role" asp-action="Index">
                        <span class="nav-link-title">Roller</span>
                    </a>
                </li>
                <li class="nav-item mb-5">
                    <a class="nav-link" asp-controller="Settings" asp-action="Index">
                        <span class="nav-link-title">Ayarlar</span>
                    </a>
                </li>
                <li class="nav-item mt-auto mb-3">
                    <a class="nav-link text-danger fw-bold" asp-controller="Auth" asp-action="Logout">
                        <span class="nav-link-title">Çıkış</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</aside>