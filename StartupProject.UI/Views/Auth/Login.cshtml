@model StartupProject.AdminUI.Models.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg">
            <div class="card-body p-5">
                <h3 class="text-center mb-4">Kurumsal Panele Giriş</h3>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @Html.ValidationSummary(false, "", new { @class = "text-danger list-unstyled" })
                    </div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email Adresi</label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="ornek@mail.com" />
                    </div>
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-bold">Şifre</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="******" />
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Giriş Yap</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>