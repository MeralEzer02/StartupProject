@using StartupProject.AdminUI.Models
@model UserViewModel

@{
    ViewData["Title"] = "Profilim";
}

<div class="page-header d-print-none mb-4 mt-2">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Profil Bilgileri</h2>
        </div>
    </div>
</div>

<div class="row row-cards">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
                <span class="avatar avatar-xl mb-3 rounded" style="background-image: url(https://ui-avatars.com/api/?name=@Model.Name&size=128)"></span>
                <h3 class="m-0 mb-1">@Model.Name @Model.Surname</h3>
                <div class="text-muted">@Model.Email</div>
                <div class="mt-3">
                    <span class="badge bg-primary text-white rounded-pill px-3 py-1">@Model.Role</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title">Hesap Detayları</h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Ad</div>
                        <div class="datagrid-content">@Model.Name</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Soyad</div>
                        <div class="datagrid-content">@Model.Surname</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Email Adresi</div>
                        <div class="datagrid-content">@Model.Email</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Yetki Rolü</div>
                        <div class="datagrid-content">
                            <span class="status status-primary text-white px-2 py-1 rounded">@Model.Role</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer text-end">
                <a asp-controller="User" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 20h4l10.5 -10.5a1.5 1.5 0 0 0 -4 -4l-10.5 10.5v4" /><line x1="13.5" y1="6.5" x2="17.5" y2="10.5" /></svg>
                    Profili Düzenle
                </a>
            </div>
        </div>
    </div>
</div>